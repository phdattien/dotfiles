[includeIf "gitdir:~/CVUT/"]
  path = ~/.gitconfig-CVUT
[user]
	name = Pham Tien Dat
	email = phamtie2@fit.cvut.cz
[core]
	editor = vim
[color]
	ui = auto
[alias]
	ll = log --oneline --graph --all --decorate
	st = status
	ci = commit
	co = checkout
	br = branch
	cleanup = "branch -vv | grep \": gone]\" | grep -v \"\\*\" | awk \"{ print \\$1; }\" | xargs -r git branch -D"
