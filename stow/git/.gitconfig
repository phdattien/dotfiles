[includeIf "gitdir:~/CVUT/"]
	path = ~/.gitconfig-CVUT
[core]
	editor = vim
[color]
	ui = auto
[alias]
	ll = log --oneline --graph --all --decorate
	st = status
	ci = commit
	co = checkout
	br = branch
	cleanup = "!git branch -vv | grep ': gone]' | grep -v '\\*' | awk '{ print $1 }' | xargs -r git branch -D"
# Identity and other per-machine settings (user.name, user.email, url rewrites). Untracked.
[include]
	path = ~/.gitconfig.local
