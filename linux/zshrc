# Portable zshrc for the Linux box (derived from the Mac/Linux .zshrc, secrets removed)
export ZSH="$HOME/.oh-my-zsh"
ZSH_THEME="robbyrussell"
plugins=(git)
[ -f "$ZSH/oh-my-zsh.sh" ] && source "$ZSH/oh-my-zsh.sh"

export PATH="$HOME/.local/bin:$PATH"
export EDITOR='nvim'
alias nv="nvim"
alias py="python3"
alias cl="clear"
alias cvut="cd ~/CVUT/; tmux"

# miniconda (only if installed)
if [ -f "$HOME/miniconda3/etc/profile.d/conda.sh" ]; then
    . "$HOME/miniconda3/etc/profile.d/conda.sh"
fi

# CUDA (only if installed)
if [ -d /usr/local/cuda ]; then
    export CUDA_HOME=/usr/local/cuda
    export PATH="/usr/local/cuda/bin${PATH:+:${PATH}}"
    export LD_LIBRARY_PATH="/usr/local/cuda/lib64${LD_LIBRARY_PATH:+:${LD_LIBRARY_PATH}}"
fi

# pyenv (only if installed)
if [ -d "$HOME/.pyenv" ]; then
    export PATH="$HOME/.pyenv/bin:$PATH"
    eval "$(pyenv init -)"
    [ -d "$HOME/.pyenv/plugins/pyenv-virtualenv" ] && eval "$(pyenv virtualenv-init -)"
fi

# secrets live outside the repo (NFBX_API_KEY, ...)
[ -f "$HOME/.secrets.zsh" ] && source "$HOME/.secrets.zsh"
export NFBX_API_BASE_URL="https://nfbx-api.salmonstone-d18d5da4.westeurope.azurecontainerapps.io"
